<Window x:Class="DesktopBarcodeApp.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impresión Etiquetas"
        Height="700"
        Width="900">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>

            <TextBlock Text="Empresa"/>
            <TextBox x:Name="txtEmpresa" Margin="0,5,0,10"/>

            <TextBlock Text="Direccion"/>
            <TextBox x:Name="txtDireccion" Margin="0,5,0,10"/>

            <TextBlock Text="Ciudad"/>
            <TextBox x:Name="txtCiudad" Margin="0,5,0,10"/>

            <TextBlock Text="Producto"/>
            <TextBox x:Name="txtProducto" Margin="0,5,0,10"/>

            <TextBlock Text="Composicion"/>
            <TextBox x:Name="txtComposicion" Margin="0,5,0,10"/>

            <TextBlock Text="Origen"/>
            <TextBox x:Name="txtOrigen" Margin="0,5,0,10"/>

            <TextBlock Text="Codigo"/>
            <TextBox x:Name="txtCodigo" Margin="0,5,0,10"/>            

            <TextBlock Text="CodigoInterno"/>
            <TextBox x:Name="txtCodigoInterno" Margin="0,5,0,10"/>

            <TextBlock Text="Metros"/>
            <TextBox x:Name="txtMetros" Margin="0,5,0,10"/>

        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0">

            <Button x:Name="btnImprimir"
                    Content="Imprimir"
                    Width="150"
                    Height="40"
                    Click="btnImprimir_Click"/>

            <Button x:Name="btnPdf"
                    Content="Exportar PDF"
                    Width="150"
                    Height="40"
                    Margin="20,0,0,0"
                    Click="btnPdf_Click"/>

        </StackPanel>

    </Grid>
</Window>